# ============================================================
# TechCampus Hub — repo-wide ignores
# ============================================================

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Personal IDE settings (machine-specific) ---
.vscode/
.idea/
*.iml

# --- Backend build output ---
TechCampusHub-Backend/target/
TechCampusHub-Backend/.apt_generated/
TechCampusHub-Backend/.classpath
TechCampusHub-Backend/.project
TechCampusHub-Backend/.settings/
TechCampusHub-Backend/*.log

# --- Runtime logs ---
boot.out.log
boot.err.log

# --- Secrets / local env overrides ---
.env
.env.*
!.env.example

# --- Node (if tooling is added later) ---
node_modules/

# --- Maven wrapper jar (downloaded by mvnw on demand) ---
TechCampusHub-Backend/.mvn/wrapper/maven-wrapper.jar
